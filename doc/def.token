# ----------------------------------------------
KEYWORDS
    # Data Types & Qualifiers (12)
    char      int       float     double    void
    signed    unsigned  short     long
    struct    enum      union

    # Storage Classes & Type Modifiers (6)
    auto      const     extern    register  static    volatile

    # Control Flow (12)
    break     case      continue  default   do        else
    for       goto      if        return    switch    while

    OPERATORS           : sizeof
    TYPE DEFINITIONS    : typedef

# ----------------------------------------------
Literals / Constants (Hardcoded Values)
    Integer Constants   
        1232 : whole num written in decimal
        0122 : ocatal leading with 0
        0x1F : hexadecimal leading with 0x/0X, suffixed U/L/UL

    Floating-Point Constants 
        123.1 : whole num written in decimal
        12e-5 : exponent e/E, suffixed f/F l/L

    Character Constants
         ' ' : anything written in single quotes

    String Literals
        " "  : anything written in double quotes

# ----------------------------------------------
Operators
    Arithmetic & Bitwise:   + - * / % ++ -- & | ^ ~ << >>
    Comparison & Logical:   == != < > <= >= && || !
    Assignment:             = += -= *= /= %= &= |= ^= <<= >>=

    Misc:
      &     (address-of)
      *     (dereference)
      .     (direct member)
      ->    (pointer member)
      ? :   (ternary conditional)
      ,     (comma operator)
      ...   (Ellipsis)

# Lexer todos
    white space     : ' \n\t\r'
    comments        : /* */ c89 style
    preprocessor:   : anything that start with # 
    identifier      : (aZAZ_)(azAZ09_)*
    token           : reserverd identifer
    literals/Const  : 'A', 012U/L, 0x12, 
    opeartor        : (3,2,1) letters operators
    Punctuators     : (){}[];:,
